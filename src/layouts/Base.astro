---
import "../styles/global.css";
import "../styles/pins.css";
import PinBar from "../components/PinBar.astro";
import { SITE as SITE_INFO, FONT_BASE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Pinned-fonts bar: "always", "mobile" (a page with its own tray column), or "none" */
  bar?: "always" | "mobile" | "none";
}

const SITE = SITE_INFO.name;
const { title, description = SITE_INFO.description, bar = "always" } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title ? `${title} · ${SITE}` : SITE;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Mark that JavaScript is running, so CSS can hide text only while JS is loading its font -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Apply the saved 配色 choice before anything is drawn (no flash of the wrong theme)
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <!-- Open connections to the font servers early; saves a round trip on first font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {FONT_BASE && <link rel="preconnect" href={new URL(FONT_BASE).origin} crossorigin />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header page">
      <a class="site-name" href="/">{SITE}</a>
      <div class="header-right">
        <nav aria-label="主导航">
          <ul>
            <li>
              <a
                href="/"
                aria-current={path === "/" ? "page" : path.startsWith("/fonts/") ? "true" : undefined}
              >字体</a>
            </li>
            <li>
              <a href="/guide/" aria-current={path.startsWith("/guide") ? "page" : undefined}>指南</a>
            </li>
            <li>
              <a href="/compare/" aria-current={path.startsWith("/compare") ? "page" : undefined}>
                对比 <span class="nav-count" data-pin-count hidden></span>
              </a>
            </li>
          </ul>
        </nav>
        <!-- 配色: an icon button, set apart from the page links. The icon shows the
             current mode: ◐ follow the system, ☀ light, ☾ dark. -->
        <button type="button" class="theme-toggle" data-theme-toggle data-mode="auto" aria-label="配色：自动（跟随系统），点按切换" title="配色：自动（跟随系统）">
          <svg class="icon-auto" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"></path>
          </svg>
          <svg class="icon-light" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2L16 16M4 16l1.8-1.8M14.2 5.8L16 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <svg class="icon-dark" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer page">
      <p class="caption">所有字体版权归各自作者所有。授权协议与来源见每款字体的信息。</p>
    </footer>
    {bar !== "none" && <PinBar mobileOnly={bar === "mobile"} />}
    <script>
      import { initPinButtons } from "../lib/pinButtons";
      import { initPinTray } from "../lib/pinTray";
      initPinButtons();
      initPinTray();

      // 配色 switch: 自动 (follow system) → 浅色 → 深色 → 自动 …
      const THEMES = [
        { id: "", mode: "auto", long: "自动（跟随系统）" },
        { id: "light", mode: "light", long: "浅色" },
        { id: "dark", mode: "dark", long: "深色" },
      ];
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
      const showTheme = () => {
        const t = THEMES.find((x) => x.id === (document.documentElement.dataset.theme ?? "")) ?? THEMES[0];
        toggle.dataset.mode = t.mode; // CSS shows the matching icon
        toggle.setAttribute("aria-label", `配色：${t.long}，点按切换`);
        toggle.title = `配色：${t.long}`;
      };
      toggle.addEventListener("click", () => {
        const i = THEMES.findIndex((x) => x.id === (document.documentElement.dataset.theme ?? ""));
        const next = THEMES[(i + 1) % THEMES.length];
        if (next.id) document.documentElement.dataset.theme = next.id;
        else delete document.documentElement.dataset.theme;
        try {
          if (next.id) localStorage.setItem("theme", next.id);
          else localStorage.removeItem("theme");
        } catch {}
        showTheme();
        window.dispatchEvent(new CustomEvent("themechange"));
      });
      showTheme();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    background: var(--accent);
    color: var(--on-accent);
    padding: var(--space-2) var(--space-3);
    z-index: 10;
  }
  .skip-link:focus {
    top: var(--space-2);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }
  .site-name {
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: var(--space-5);
  }
  nav a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-2);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  /* A round icon button, visually separate from the text links */
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--duration),
      border-color var(--duration);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }
  .theme-toggle svg {
    display: none;
  }
  .theme-toggle[data-mode="auto"] .icon-auto,
  .theme-toggle[data-mode="light"] .icon-light,
  .theme-toggle[data-mode="dark"] .icon-dark {
    display: block;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--ink);
  }
  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  /* Number of pinned fonts, next to 对比 */
  .nav-count {
    display: inline-block;
    min-width: 1.5em;
    padding: 0 var(--space-1);
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-xs);
    line-height: 1.5;
    text-align: center;
  }
  .nav-count[hidden] {
    display: none;
  }

  .site-footer {
    margin-top: var(--space-9);
    padding-top: var(--space-4);
    padding-bottom: var(--space-7);
    border-top: 1px solid var(--rule);
  }
</style>
