---
import { categoriesOf, categoryLabel, displayWeight, type FontEntry } from "../lib/fonts";
import VersionTags from "./VersionTags.astro";
import PinButton from "./PinButton.astro";

interface Props {
  font: FontEntry;
}
const { font } = Astro.props;
const defaultWeight = displayWeight(font.weights);
---

<li
  class="card"
  data-id={font.id}
  data-categories={categoriesOf(font).join(" ")}
  data-weights={font.weights.join(" ")}
  data-current-weight={displayWeight(font.weights)}
>
  <a class="card-link" href={`/fonts/${font.id}/`}>
    <!-- The specimen is the card's main content. It's hidden from screen readers
         because the label below already says the same thing in plain text. -->
    <p
      class="specimen"
      lang="zh-Hans"
      aria-hidden="true"
      data-state="idle"
      style={`font-family: "${font.webfont.family}", var(--font-ui); font-weight: ${defaultWeight}`}
    >
      {font.name.zh}
    </p>
    <div class="label">
      <p class="label-name">
        <span class="name-zh">{font.name.zh}</span>
        <span class="name-en" lang="en">{font.name.en}</span>
      </p>
      <p class="label-meta caption">
        <span>{categoryLabel(font)} · <span lang="en">{font.license.id}</span></span>
        <span class="status" role="status"></span>
      </p>
    </div>
  </a>

  <!-- Tags and pin sit outside the link because a link can't contain buttons -->
  <div class="card-foot">
    <VersionTags font={font} />
    <PinButton id={font.id} name={font.name.zh} />
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--rule);
  }
  .card-foot {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    text-decoration: none;
  }

  .specimen {
    /* Fixed height (two lines) so the grid never jumps while fonts load */
    --lh: 1.3;
    font-size: var(--specimen-card);
    line-height: var(--lh);
    height: calc(2em * var(--lh));
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
    transition: opacity var(--duration) ease-out;
  }
  /* Only when JS is running (and will load the font) do we hide the fallback text */
  :global(html.js) .specimen[data-state="idle"] {
    opacity: 0;
  }

  .label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .label-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .name-zh {
    font-weight: 600;
  }
  .name-en {
    color: var(--ink-2);
  }
  .label-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .status {
    flex-shrink: 0;
  }

  .card-link:hover .name-zh,
  .card-link:focus-visible .name-zh {
    color: var(--accent);
  }
  .card-link:focus-visible {
    outline-offset: 4px;
  }
</style>
