---
import { categoryName, displayWeight, WEIGHT_NAMES, type FontEntry } from "../lib/fonts";

interface Props {
  font: FontEntry;
}
const { font } = Astro.props;
const defaultWeight = displayWeight(font.weights);
---

<li
  class="card"
  data-id={font.id}
  data-category={font.category}
  data-weights={font.weights.join(" ")}
>
  <a class="card-link" href={`/fonts/${font.id}/`}>
    <!-- The specimen is the card's main content. It's hidden from screen readers
         because the label below already says the same thing in plain text. -->
    <p
      class="specimen"
      lang="zh-Hans"
      aria-hidden="true"
      data-state="idle"
      style={`font-family: "${font.webfont.family}", var(--font-ui); font-weight: ${defaultWeight}`}
    >
      {font.name.zh}
    </p>
    <div class="label">
      <p class="label-name">
        <span class="name-zh">{font.name.zh}</span>
        <span class="name-en" lang="en">{font.name.en}</span>
      </p>
      <p class="label-meta caption">
        <span>{categoryName(font.category)} · <span lang="en">{font.license.id}</span></span>
        <span class="status" role="status"></span>
      </p>
    </div>
  </a>

  <!-- Every version this font comes in. They're buttons (outside the link, since
       a link can't contain buttons): pressing one previews that version above. -->
  <div class="tags" role="group" aria-label={`${font.name.zh}的字重与版本，点按预览`}>
    {
      font.weights.map((w) => (
        <button
          type="button"
          class="tag"
          data-weight={w}
          aria-pressed={w === defaultWeight ? "true" : "false"}
          title={`${WEIGHT_NAMES[w]} ${w}`}
        >
          {WEIGHT_NAMES[w]}
        </button>
      ))
    }
    {
      font.variants.map((v, i) => (
        <button
          type="button"
          class="tag tag-variant"
          data-variant={i}
          aria-pressed="false"
          disabled={!v.webfont}
        >
          {v.zh}
        </button>
      ))
    }
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--rule);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    text-decoration: none;
  }

  .specimen {
    /* Fixed height (two lines) so the grid never jumps while fonts load */
    --lh: 1.3;
    font-size: var(--specimen-card);
    line-height: var(--lh);
    height: calc(2em * var(--lh));
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
    transition: opacity var(--duration) ease-out;
  }
  /* Only when JS is running (and will load the font) do we hide the fallback text */
  :global(html.js) .specimen[data-state="idle"] {
    opacity: 0;
  }

  .label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .label-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .name-zh {
    font-weight: 600;
  }
  .name-en {
    color: var(--ink-2);
  }
  .label-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .status {
    flex-shrink: 0;
  }

  .card-link:hover .name-zh,
  .card-link:focus-visible .name-zh {
    color: var(--accent);
  }
  .card-link:focus-visible {
    outline-offset: 4px;
  }

  /* Tags: small and square-cornered, so they read as labels, not as the
     round filter chips at the top of the page */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tag {
    padding: 2px var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: none;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--duration),
      border-color var(--duration);
  }
  .tag:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .tag[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* Variants (e.g. 等宽版) are a different kind of version than weights */
  .tag-variant {
    border-style: dashed;
  }
  .tag:not(.tag-variant) + .tag-variant {
    /* a little extra space between the weights and the variants */
    margin-left: var(--space-2);
  }
  .tag:disabled {
    cursor: default;
    opacity: 0.6;
  }
</style>
