---
// "相似字体": the nearest neighbours computed by similarity/scripts/build_similar.py,
// plus a "找更…" control that looks for fonts like this one but bolder, rounder, etc.
import similar from "../data/similar.json";
import { fonts, displayWeight, type FontEntry } from "../lib/fonts";
import { NUDGES } from "../lib/nudge";
import PinButton from "./PinButton.astro";

interface Props {
  font: FontEntry;
}
const { font } = Astro.props;
const byId = new Map(fonts.map((f) => [f.id, f]));
// Already sorted most similar first by the build script
const neighbours = ((similar as Record<string, { id: string; similarity: number; reason: string }[]>)[font.id] ?? [])
  .map((n) => ({ ...n, font: byId.get(n.id) }))
  .filter((n) => n.font);

// Group the nudge buttons by axis: 字重 [更粗][更细] · 圆润 [更圆][更方] …
const groups = [...new Set(NUDGES.map((n) => n.group))].map((g) => ({ name: g, items: NUDGES.filter((n) => n.group === g) }));
---

{
  neighbours.length > 0 && (
    <section class="similar" aria-labelledby="similar-title" data-similar data-font-id={font.id} data-font-name={font.name.zh}>
      <div class="similar-head">
        <h2 id="similar-title" class="section-title">相似字体</h2>
        <p class="caption">按笔形、字重、标题感、圆润度等特征计算，最相似的在前</p>
      </div>

      <form class="nudges" aria-label="找风格相近、但某一方面不同的字体">
        <span class="caption nudge-lead">找更…</span>
        <label class="nudge">
          <input type="radio" name="nudge" value="" checked />
          <span>相似</span>
        </label>
        {groups.map((g) => (
          <span class="nudge-group" role="group" aria-label={g.name}>
            <span class="caption">{g.name}</span>
            {g.items.map((n) => (
              <label class="nudge">
                <input type="radio" name="nudge" value={n.id} />
                <span>{n.zh}</span>
              </label>
            ))}
          </span>
        ))}
      </form>
      <p class="caption nudge-status" data-nudge-status aria-live="polite"></p>

      <ol class="similar-grid" data-similar-list>
        {neighbours.map(({ font: f, reason, similarity }) => (
          <li class="sim" data-sim-id={f!.id} data-current-weight={displayWeight(f!.weights)}>
            <a class="sim-link" href={`/fonts/${f!.id}/`}>
              <p class="sim-specimen" lang="zh-Hans" aria-hidden="true" data-state="idle">
                {f!.name.zh}
              </p>
              <p class="sim-name">
                <span class="zh">{f!.name.zh}</span>
                <span class="en" lang="en">{f!.name.en}</span>
              </p>
              <p class="caption sim-reason">
                <span class="sim-pct">相似度 {Math.round(similarity * 100)}%</span> · {reason}
              </p>
            </a>
            <PinButton id={f!.id} name={f!.name.zh} />
          </li>
        ))}
      </ol>
    </section>
  )
}

<style is:global>
  /* Global because the script below re-creates these cards when you pick a
     direction, and Astro's scoped styles only reach elements it rendered. */
  .similar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .similar-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .similar .section-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .nudges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .nudge-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .nudge-group > .caption {
    margin-right: var(--space-1);
  }
  .nudge {
    position: relative;
    cursor: pointer;
  }
  .nudge input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .nudge span {
    display: inline-block;
    padding: 1px var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: var(--text-xs);
    line-height: 1.7;
    transition:
      background-color var(--duration),
      border-color var(--duration),
      color var(--duration);
  }
  .nudge:hover span {
    border-color: var(--ink);
  }
  .nudge input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .nudge input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nudge-status:empty {
    display: none;
  }

  .similar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(min(240px, 100%), (100% - 2 * var(--space-7)) / 3), 1fr));
    gap: 0 var(--space-7);
  }
  .sim {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--rule);
  }
  .sim-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    width: 100%;
  }
  .sim-specimen {
    font-size: var(--text-2xl);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity var(--duration);
  }
  html.js .sim-specimen[data-state="idle"] {
    opacity: 0;
  }
  .sim-name {
    font-size: var(--text-sm);
  }
  .sim-name .zh {
    font-weight: 600;
  }
  .sim-name .en {
    margin-left: var(--space-2);
    color: var(--ink-2);
  }
  .sim-pct {
    color: var(--ink);
  }
  .sim-link:hover .zh,
  .sim-link:focus-visible .zh {
    color: var(--accent);
  }
</style>

<script>
  import { fonts, displayWeight } from "../lib/fonts";
  import { loadFont } from "../lib/fontLoader";
  import { nudge, NUDGES, axisName, type NudgeId } from "../lib/nudge";
  import { syncPinButtons } from "../lib/pinButtons";
  import similar from "../data/similar.json";

  const byId = new Map(fonts.map((f) => [f.id, f]));
  const section = document.querySelector<HTMLElement>("[data-similar]");

  // Load each card's name (a tiny subset) when it scrolls into view
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const li = e.target as HTMLElement;
        const font = byId.get(li.dataset.simId!)!;
        const el = li.querySelector<HTMLElement>(".sim-specimen")!;
        const weight = displayWeight(font.weights);
        loadFont(font, weight, font.name.zh, { subset: true })
          .then((family) => {
            el.style.fontFamily = `"${family}", var(--font-ui)`;
            el.style.fontWeight = String(weight);
            el.dataset.state = "ready";
          })
          .catch(() => (el.dataset.state = "error"));
      }
    },
    { rootMargin: "200px 0px" },
  );
  document.querySelectorAll("[data-sim-id]").forEach((li) => io.observe(li));

  if (section) {
    const list = section.querySelector<HTMLOListElement>("[data-similar-list]")!;
    const status = section.querySelector<HTMLElement>("[data-nudge-status]")!;
    const selfId = section.dataset.fontId!;
    const selfName = section.dataset.fontName!;

    // Build one card (same markup as the server-rendered ones)
    function card(id: string, caption: string): HTMLLIElement {
      const f = byId.get(id)!;
      const li = document.createElement("li");
      li.className = "sim";
      li.dataset.simId = id;
      li.dataset.currentWeight = String(displayWeight(f.weights));
      li.innerHTML = `
        <a class="sim-link" href="/fonts/${id}/">
          <p class="sim-specimen" lang="zh-Hans" aria-hidden="true" data-state="idle"></p>
          <p class="sim-name"><span class="zh"></span><span class="en" lang="en"></span></p>
          <p class="caption sim-reason"></p>
        </a>
        <button type="button" class="pin-button" data-pin="${id}" aria-pressed="false">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 1.5h6M6 1.5v4L3.5 9h9L10 5.5v-4M8 9v5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span data-pin-label>钉选</span>
        </button>`;
      li.querySelector(".sim-specimen")!.textContent = f.name.zh;
      li.querySelector(".zh")!.textContent = f.name.zh;
      li.querySelector(".en")!.textContent = f.name.en;
      li.querySelector(".sim-reason")!.innerHTML = caption; // built from our own data only
      return li;
    }

    function show(nudgeId: NudgeId | "") {
      let items: HTMLLIElement[];
      if (!nudgeId) {
        const base = (similar as Record<string, { id: string; similarity: number; reason: string }[]>)[selfId] ?? [];
        items = base.map((n) =>
          card(n.id, `<span class="sim-pct">相似度 ${Math.round(n.similarity * 100)}%</span> · ${n.reason}`),
        );
        status.textContent = "";
      } else {
        const n = NUDGES.find((x) => x.id === nudgeId)!;
        const results = nudge(selfId, nudgeId);
        items = results.map((r) =>
          card(
            r.id,
            `<span class="sim-pct">${axisName(n.axis)} ${r.from.toFixed(2)} → ${r.to.toFixed(2)}</span> · ${r.reason}`,
          ),
        );
        status.textContent = results.length
          ? `比「${selfName}」${n.phrase}、其他特征尽量接近的字体`
          : `字体库里没有比「${selfName}」${n.phrase}的字体了。`;
      }
      list.replaceChildren(...items);
      items.forEach((li) => io.observe(li));
      syncPinButtons();
    }

    section.querySelector("form")!.addEventListener("change", (e) => {
      show((e.target as HTMLInputElement).value as NudgeId | "");
    });
  }
</script>
