---
// "相似字体": the nearest neighbours computed by similarity/scripts/build_similar.py,
// plus a "找更…" control that looks for fonts like this one but bolder, rounder, etc.
import similar from "../data/similar.json";
import { fonts, displayWeight, type FontEntry } from "../lib/fonts";
import { DIALS } from "../lib/nudge";
import PinButton from "./PinButton.astro";

interface Props {
  font: FontEntry;
}
const { font } = Astro.props;
const byId = new Map(fonts.map((f) => [f.id, f]));
// Already sorted most similar first by the build script
const neighbours = ((similar as Record<string, { id: string; similarity: number; reason: string }[]>)[font.id] ?? [])
  .map((n) => ({ ...n, font: byId.get(n.id) }))
  .filter((n) => n.font);
---

{
  neighbours.length > 0 && (
    <section class="similar" aria-labelledby="similar-title" data-similar data-font-id={font.id} data-font-name={font.name.zh}>
      <div class="similar-head">
        <h2 id="similar-title" class="section-title">相似字体</h2>
        <p class="caption">按笔形、字重、标题感、圆润度等特征计算，最相似的在前</p>
      </div>

      <!-- Left: switches to steer the list. Right: the fonts. (Stacked on phones.) -->
      <div class="similar-body">
        <form class="dials" aria-label="找风格相近、但在某些方面不同的字体">
          <p class="caption dials-lead">找更…（可同时选多项）</p>
          {DIALS.map((d) => (
            <fieldset class="dial">
              <legend class="caption">{d.zh}</legend>
              <div class="seg">
                <label>
                  <input type="radio" name={d.axis} value="-1" />
                  <span>{d.less}</span>
                </label>
                <label>
                  <input type="radio" name={d.axis} value="" checked />
                  <span>不限</span>
                </label>
                <label>
                  <input type="radio" name={d.axis} value="1" />
                  <span>{d.more}</span>
                </label>
              </div>
            </fieldset>
          ))}
          <button type="reset" class="dials-reset" data-dials-reset hidden>全部改回不限</button>
        </form>

        <div class="similar-results">
          <p class="caption nudge-status" data-nudge-status aria-live="polite">最相似的字体</p>
          <ol class="similar-grid" data-similar-list>
            {neighbours.map(({ font: f, reason, similarity }) => (
              <li class="sim" data-sim-id={f!.id} data-current-weight={displayWeight(f!.weights)}>
                <a class="sim-link" href={`/fonts/${f!.id}/`}>
                  <p class="sim-specimen" lang="zh-Hans" aria-hidden="true" data-state="idle">
                    {f!.name.zh}
                  </p>
                  <p class="sim-name">
                    <span class="zh">{f!.name.zh}</span>
                    <span class="en" lang="en">{f!.name.en}</span>
                  </p>
                  <p class="caption sim-reason">
                    <span class="sim-pct">相似度 {Math.round(similarity * 100)}%</span> · {reason}
                  </p>
                </a>
                <PinButton id={f!.id} name={f!.name.zh} />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  /* Global because the script below re-creates these cards when you pick a
     direction, and Astro's scoped styles only reach elements it rendered. */
  .similar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .similar-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .similar .section-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .similar-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .similar-body {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }
    .dials {
      position: sticky;
      top: var(--space-5);
    }
  }

  .dials {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .dial {
    display: grid;
    grid-template-columns: 3.5em 1fr;
    align-items: center;
    gap: var(--space-2);
  }
  .dial legend {
    float: left; /* lets the legend sit in the grid row like a label */
    padding: 0;
  }
  /* Three joined buttons: less · 不限 · more */
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .seg label {
    position: relative;
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    display: block;
    padding: 2px 0;
    border: 1px solid var(--rule-strong);
    margin-left: -1px; /* neighbouring borders overlap into one line */
    font-size: var(--text-xs);
    line-height: 1.7;
    text-align: center;
    white-space: nowrap;
    transition:
      background-color var(--duration),
      color var(--duration);
  }
  .seg label:first-child span {
    margin-left: 0;
    border-radius: 2px 0 0 2px;
  }
  .seg label:last-child span {
    border-radius: 0 2px 2px 0;
  }
  .seg input[value=""] + span {
    color: var(--ink-2);
  }
  .seg label:hover span {
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }
  .seg input:checked:not([value=""]) + span {
    position: relative; /* draw the accent border above its neighbours */
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .seg input:checked[value=""] + span {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    position: relative;
  }
  .dials-reset {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: var(--space-1) 0;
    font-size: var(--text-xs);
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .dials-reset:hover {
    color: var(--accent);
  }

  .similar-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .nudge-status {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    color: var(--ink);
  }
  .sim-reason .miss {
    color: var(--ink-2);
    text-decoration: line-through;
  }

  .similar-grid {
    display: grid;
    /* at most 2 per row next to the switches, so lines stay short */
    grid-template-columns: repeat(auto-fill, minmax(max(min(220px, 100%), (100% - var(--space-6)) / 2), 1fr));
    gap: 0 var(--space-6);
  }
  .sim {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--rule);
  }
  .sim-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    width: 100%;
  }
  .sim-specimen {
    font-size: var(--text-2xl);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity var(--duration);
  }
  html.js .sim-specimen[data-state="idle"] {
    opacity: 0;
  }
  .sim-name {
    font-size: var(--text-sm);
  }
  .sim-name .zh {
    font-weight: 600;
  }
  .sim-name .en {
    margin-left: var(--space-2);
    color: var(--ink-2);
  }
  .sim-pct {
    color: var(--ink);
  }
  .sim-link:hover .zh,
  .sim-link:focus-visible .zh {
    color: var(--accent);
  }
</style>

<script>
  import { fonts, displayWeight } from "../lib/fonts";
  import { loadFont } from "../lib/fontLoader";
  import { nudge, DIALS, axisName, type Axis, type Wishes } from "../lib/nudge";
  import { syncPinButtons } from "../lib/pinButtons";
  import similar from "../data/similar.json";

  const byId = new Map(fonts.map((f) => [f.id, f]));
  const section = document.querySelector<HTMLElement>("[data-similar]");

  // Load each card's name (a tiny subset) when it scrolls into view
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const li = e.target as HTMLElement;
        const font = byId.get(li.dataset.simId!)!;
        const el = li.querySelector<HTMLElement>(".sim-specimen")!;
        const weight = displayWeight(font.weights);
        loadFont(font, weight, font.name.zh, { subset: true })
          .then((family) => {
            el.style.fontFamily = `"${family}", var(--font-ui)`;
            el.style.fontWeight = String(weight);
            el.dataset.state = "ready";
          })
          .catch(() => (el.dataset.state = "error"));
      }
    },
    { rootMargin: "200px 0px" },
  );
  document.querySelectorAll("[data-sim-id]").forEach((li) => io.observe(li));

  if (section) {
    const list = section.querySelector<HTMLOListElement>("[data-similar-list]")!;
    const status = section.querySelector<HTMLElement>("[data-nudge-status]")!;
    const selfId = section.dataset.fontId!;
    const selfName = section.dataset.fontName!;

    // Build one card (same markup as the server-rendered ones)
    function card(id: string, caption: string): HTMLLIElement {
      const f = byId.get(id)!;
      const li = document.createElement("li");
      li.className = "sim";
      li.dataset.simId = id;
      li.dataset.currentWeight = String(displayWeight(f.weights));
      li.innerHTML = `
        <a class="sim-link" href="/fonts/${id}/">
          <p class="sim-specimen" lang="zh-Hans" aria-hidden="true" data-state="idle"></p>
          <p class="sim-name"><span class="zh"></span><span class="en" lang="en"></span></p>
          <p class="caption sim-reason"></p>
        </a>
        <button type="button" class="pin-button" data-pin="${id}" aria-pressed="false">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 1.5h6M6 1.5v4L3.5 9h9L10 5.5v-4M8 9v5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span data-pin-label>钉选</span>
        </button>`;
      li.querySelector(".sim-specimen")!.textContent = f.name.zh;
      li.querySelector(".zh")!.textContent = f.name.zh;
      li.querySelector(".en")!.textContent = f.name.en;
      li.querySelector(".sim-reason")!.innerHTML = caption; // built from our own data only
      return li;
    }

    const form = section.querySelector<HTMLFormElement>("form")!;
    const resetBtn = section.querySelector<HTMLButtonElement>("[data-dials-reset]")!;

    function readWishes(): Wishes {
      const wishes: Wishes = {};
      const data = new FormData(form);
      for (const d of DIALS) {
        const v = data.get(d.axis);
        if (v === "1" || v === "-1") wishes[d.axis] = Number(v) as -1 | 1;
      }
      return wishes;
    }

    function show() {
      const wishes = readWishes();
      const chosen = Object.entries(wishes) as [Axis, -1 | 1][];
      resetBtn.hidden = chosen.length === 0;
      let items: HTMLLIElement[];

      if (chosen.length === 0) {
        const base = (similar as Record<string, { id: string; similarity: number; reason: string }[]>)[selfId] ?? [];
        items = base.map((n) =>
          card(n.id, `<span class="sim-pct">相似度 ${Math.round(n.similarity * 100)}%</span> · ${n.reason}`),
        );
        status.textContent = "最相似的字体";
      } else {
        const phrase = chosen
          .map(([a, dir]) => {
            const d = DIALS.find((x) => x.axis === a)!;
            return dir > 0 ? d.morePhrase : d.lessPhrase;
          })
          .join("、");
        const { results, complete } = nudge(selfId, wishes);
        items = results.map((r) =>
          card(
            r.id,
            r.changes
              .map(
                (c) =>
                  `<span class="sim-pct${c.ok ? "" : " miss"}">${axisName(c.axis)} ${c.from.toFixed(2)} → ${c.to.toFixed(2)}</span>`,
              )
              .join(" · ") + ` · ${r.reason}`,
          ),
        );
        status.textContent = !results.length
          ? `字体库里没有比「${selfName}」${phrase}的字体了。`
          : complete
            ? `比「${selfName}」${phrase}，其他特征尽量接近的字体`
            : `没有同时满足全部条件的字体；以下是满足最多条件的（划线的是没做到的）`;
      }
      list.replaceChildren(...items);
      items.forEach((li) => io.observe(li));
      syncPinButtons();
    }

    form.addEventListener("change", show);
    // "reset" fires before the radios change back, so wait a tick
    form.addEventListener("reset", () => setTimeout(show));
  }
</script>
