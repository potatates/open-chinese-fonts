---
// A "钉选" (pin) toggle. Its state is filled in by src/lib/pinButtons.ts,
// which also finds the weight to pin from the nearest [data-current-weight].
interface Props {
  id: string;
  name: string;
}
const { id, name } = Astro.props;
---

<button type="button" class="pin-button" data-pin={id} data-name={name} aria-pressed="false">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <path
      d="M5 1.5h6M6 1.5v4L3.5 9h9L10 5.5v-4M8 9v5.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span data-pin-label>钉选</span>
</button>
