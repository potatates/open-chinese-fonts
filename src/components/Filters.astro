---
// Category + weight filters. They're ordinary radio buttons (so keyboard
// arrow keys, screen readers and forms all work for free), styled as chips.
import { CATEGORIES, WEIGHT_BUCKETS } from "../lib/fonts";

const groups = [
  { name: "cat", legend: "分类", options: CATEGORIES.map((c) => ({ value: c.id, zh: c.zh })) },
  { name: "w", legend: "字重", options: WEIGHT_BUCKETS.map((b) => ({ value: b.id, zh: b.zh })) },
];
---

<form class="filters" aria-label="筛选字体" data-filters>
  {
    groups.map((g) => (
      <fieldset class="group">
        <legend class="caption">{g.legend}</legend>
        <div class="chips">
          <label class="chip">
            <input type="radio" name={g.name} value="" checked />
            <span>全部</span>
          </label>
          {g.options.map((o) => (
            <label class="chip">
              <input type="radio" name={g.name} value={o.value} />
              <span>{o.zh}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))
  }
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .group {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  legend {
    /* legends are laid out specially; float makes them sit in the row */
    float: left;
    flex-shrink: 0;
    width: 3em;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
    line-height: 1.5;
    transition:
      background-color var(--duration),
      border-color var(--duration),
      color var(--duration);
  }
  .chip:hover span {
    border-color: var(--ink);
  }
  .chip input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
