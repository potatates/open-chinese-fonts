---
// One page per purpose (/use/headline/ …): what people search for, filled from
// the fonts' scores and tags (see USE_PAGES in src/lib/seo.ts). Laid out as a
// wall of cards: each font's name big in its own font, a sample line, tags.
import Base from "../../layouts/Base.astro";
import PinButton from "../../components/PinButton.astro";
import { WEIGHT_NAMES, LICENSES, categoryName, roomAbove, displayWeight } from "../../lib/fonts";
import { USE_PAGES, useFonts, traits, breadcrumbs, freeLabel, SITE_URL } from "../../lib/seo";
import samples from "../../data/samples.json";

export function getStaticPaths() {
  return USE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { slug: page.slug } }));
}

// Which sample sentence (src/data/samples.json) suits each style. These have
// tiny ready-made font files, so a card costs a few KB like the name does.
const SAMPLE: Record<string, number> = {
  headline: 6, // 海内存知己，天涯若比邻。
  body: 0, // 春眠不觉晓…
  brush: 7, // 落霞与孤鹜齐飞…
  cute: 4, // 学而时习之…
  pixel: 9, // 中英混排 + 数字
  slides: 8, // 数字与标点
  handwritten: 1, // 床前明月光…
  retro: 3, // 山不在高…
  pinyin: 1,
  bold: 5, // 天行健…
};

interface Props {
  slug: string;
}
const page = USE_PAGES.find((p) => p.slug === Astro.props.slug)!;
const list = useFonts(page);
const others = USE_PAGES.filter((p) => p.slug !== page.slug);
const sample = (samples as { text: string }[])[SAMPLE[page.slug] ?? 0].text;
const title = `${page.title}（${list.length} 款）`;
const jsonLd = [
  breadcrumbs([
    ["全部字体", "/"],
    ["按风格找字体", "/use/"],
    [page.title, `/use/${page.slug}/`],
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: `${SITE_URL}/use/${page.slug}/`,
    inLanguage: "zh-Hans",
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: list.length,
      itemListElement: list.map((f, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: f.name.zh,
        url: `${SITE_URL}/fonts/${f.id}/`,
      })),
    },
  },
];
---

<Base title={title} description={`${list.length} 款${page.title}。${page.intro}`} jsonLd={jsonLd}>
  <nav class="crumbs caption" aria-label="位置">
    <a href="/">全部字体</a>
    <span aria-hidden="true">/</span>
    <a href="/use/">风格</a>
    <span aria-hidden="true">/</span>
    <span>{page.title}</span>
  </nav>

  <section class="intro">
    <h1>{title}</h1>
    <p class="lede">{page.intro}</p>
  </section>

  <ol class="wall">
    {
      list.map((f) => (
        <li class="card" data-current-weight={displayWeight(f.weights)}>
          <a class="card-link" href={`/fonts/${f.id}/`}>
            <span class="big specimen" data-specimen={f.id} data-text={f.name.zh} data-room={roomAbove(f)} lang="zh-Hans" data-state="idle">
              {f.name.zh}
            </span>
            <span class="line specimen" data-specimen={f.id} data-text={sample} data-room={roomAbove(f)} lang="zh-Hans" data-state="idle" aria-hidden="true">
              {sample}
            </span>
          </a>
          <div class="card-foot">
            <span class="caption" lang="en">
              {f.name.en !== f.name.zh ? f.name.en : f.designer} · {f.year}
            </span>
            <PinButton id={f.id} name={f.name.zh} />
          </div>
          <ul class="tags">
            <li>{categoryName(f.category)}</li>
            <li>{f.weights.length > 1 ? `${f.weights.length} 种粗细` : WEIGHT_NAMES[f.weights[0]]}</li>
            <li class="free">
              {freeLabel(f)}（{LICENSES[f.license.id]?.name ?? f.license.id}）
            </li>
            {traits(f).slice(0, 2).map((t) => <li>{t}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>

  <nav class="others caption" aria-label="其他风格">
    其他风格：
    {others.map((p) => <a href={`/use/${p.slug}/`}>{p.short}</a>)}
  </nav>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-5);
  }
  .intro {
    padding: var(--space-5) 0 var(--space-6);
    max-width: 42em;
  }
  .intro h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }
  .lede {
    line-height: 1.9;
    margin-bottom: var(--space-2);
  }
  /* A wall of cards: as many columns as fit, one on phones */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-7);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: 2px;
    transition: border-color var(--duration);
  }
  .card:hover {
    border-color: var(--ink-2);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
    text-decoration: none;
  }
  .specimen {
    transition: opacity var(--duration);
  }
  :global(html.js) .specimen[data-state="idle"] {
    opacity: 0.15;
  }
  /* the name, one line, as big as it comfortably fits */
  .big {
    font-size: 2.25rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-link:hover .big {
    color: var(--accent);
  }
  .line {
    font-size: var(--text-md);
    line-height: 1.8;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  .card-foot .caption {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tags li {
    font-size: var(--text-xs);
    line-height: 1.6;
    padding: 0 var(--space-2);
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-2);
  }
  .tags .free {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }
</style>

<script>
  import { fonts, displayWeight } from "../../lib/fonts";
  import { loadFont } from "../../lib/fontLoader";

  // Each name and sample line in its own font (tiny ready-made files for
  // exactly that text), loaded as it scrolls into view
  const byId = new Map(fonts.map((f) => [f.id, f]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const font = byId.get(el.dataset.specimen!)!;
        const weight = displayWeight(font.weights);
        loadFont(font, weight, el.dataset.text!, { subset: true })
          .then((family) => {
            el.style.fontFamily = `"${family}", var(--font-ui)`;
            el.style.fontWeight = String(weight);
            el.dataset.state = "ready";
          })
          .catch(() => (el.dataset.state = "error"));
      }
    },
    { rootMargin: "300px 0px" },
  );
  document.querySelectorAll("[data-specimen]").forEach((el) => io.observe(el));
</script>
