---
// 风格: fonts by vibe and purpose. One card per page in USE_PAGES (src/lib/seo.ts),
// each with a few example names drawn in their own fonts.
import Base from "../../layouts/Base.astro";
import { USE_PAGES, useFonts, breadcrumbs } from "../../lib/seo";
import { roomAbove } from "../../lib/fonts";

const cards = USE_PAGES.map((page) => {
  const list = useFonts(page);
  return { ...page, count: list.length, examples: list.slice(0, 4) };
});
---

<Base
  title="按风格找字体"
  description={`按用途和气质找免费商用中文字体：${USE_PAGES.map((p) => p.short).join("、")}。每款都能在线预览、找相似字体。`}
  jsonLd={breadcrumbs([
    ["全部字体", "/"],
    ["按风格找字体", "/use/"],
  ])}
>
  <section class="intro">
    <h1>按风格找字体</h1>
    <p class="lede">不知道从哪个分类找起？按你要做的东西、想要的感觉来挑。</p>
  </section>

  <!-- One box per style: name → one big sample → quieter details -->
  <ol class="cards">
    {
      cards.map((c) => (
        <li>
          <a class="card" href={`/use/${c.slug}/`}>
            <span class="card-top">
              <span class="card-title">{c.short}</span>
              <span class="visually-hidden">：{c.title}</span>
              <span class="card-count">{c.count} 款 →</span>
            </span>
            <span class="examples" aria-hidden="true">
              <span class="hero specimen" data-specimen={c.examples[0].id} data-room={roomAbove(c.examples[0])} lang="zh-Hans" data-state="idle">
                {c.examples[0].name.zh}
              </span>
              <span class="also">
                {c.examples.slice(1).map((f) => (
                  <span class="specimen" data-specimen={f.id} data-room={roomAbove(f)} lang="zh-Hans" data-state="idle">
                    {f.name.zh}
                  </span>
                ))}
              </span>
            </span>
            <span class="card-intro">{c.intro}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .intro {
    padding: var(--space-7) 0 var(--space-5);
    max-width: 42em;
  }
  h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }
  .lede {
    color: var(--ink-2);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 0 var(--space-7);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4) 0 var(--space-7);
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .card:hover .card-title {
    color: var(--accent);
  }
  .card-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    white-space: nowrap;
  }
  .examples {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) 0 var(--space-1);
  }
  .specimen {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity var(--duration);
  }
  .hero {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }
  .also {
    display: flex;
    gap: var(--space-4);
    min-width: 0;
    color: var(--ink-2);
  }
  .also .specimen {
    font-size: var(--text-md);
    line-height: 1.5;
    min-width: 0;
  }
  :global(html.js) .specimen[data-state="idle"] {
    opacity: 0.2;
  }
  .card-intro {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import { fonts, displayWeight } from "../../lib/fonts";
  import { loadFont } from "../../lib/fontLoader";

  const byId = new Map(fonts.map((f) => [f.id, f]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const font = byId.get(el.dataset.specimen!)!;
        const weight = displayWeight(font.weights);
        loadFont(font, weight, font.name.zh, { subset: true })
          .then((family) => {
            el.style.fontFamily = `"${family}", var(--font-ui)`;
            el.style.fontWeight = String(weight);
            el.dataset.state = "ready";
          })
          .catch(() => (el.dataset.state = "error"));
      }
    },
    { rootMargin: "300px 0px" },
  );
  document.querySelectorAll("[data-specimen]").forEach((el) => io.observe(el));
</script>
