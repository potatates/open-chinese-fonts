---
// 分享搭配: a title font + body font pairing that lives in the URL, so it can
// be shared. /pair/?h=<id>&hw=<weight>&b=<id>&bw=<weight>&t=<title>&p=<body>
// Everything is read in the browser; the page itself is the same for everyone.
import Base from "../layouts/Base.astro";
---

<Base title="字体搭配" description="标题字体 + 正文字体的搭配预览，可分享链接或保存为图片。" noindex>
  <section class="pair-page" data-pair-page>
    <p class="caption crumbs"><a href="/">全部字体</a> / 字体搭配</p>
    <h1 class="visually-hidden">字体搭配</h1>

    <div class="sheet" data-sheet>
      <p class="sheet-head" data-head lang="zh-Hans" data-state="idle"></p>
      <p class="sheet-body" data-body lang="zh-Hans" data-state="idle"></p>
    </div>

    <dl class="fonts caption">
      <div><dt>标题</dt><dd><a data-head-link></a></dd></div>
      <div><dt>正文</dt><dd><a data-body-link></a></dd></div>
    </dl>

    <div class="actions">
      <button type="button" class="action primary" data-copy>复制分享链接</button>
      <button type="button" class="action" data-save>保存为图片</button>
      <button type="button" class="action" data-pin-both>钉选这两款</button>
      <span class="caption status" data-status role="status"></span>
    </div>

    <p class="empty" data-empty hidden>
      这个链接里没有有效的字体。在字库里钉选两款字体，就能在「搭配预览」里分享搭配。
      <a href="/">去字库 →</a>
    </p>
  </section>
</Base>

<style>
  .pair-page {
    max-width: 52rem;
    padding: var(--space-6) 0 var(--space-8);
  }
  .crumbs {
    margin-bottom: var(--space-5);
  }
  .sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7);
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .sheet-head {
    font-size: clamp(32px, 6vw, 56px);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .sheet-body {
    font-size: 20px;
    line-height: 1.9;
    white-space: pre-wrap;
  }
  :global(html.js) .sheet [data-state="idle"] {
    opacity: 0;
  }
  .sheet p {
    transition: opacity var(--duration);
  }
  .fonts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: var(--space-4) 0;
  }
  .fonts div {
    display: flex;
    gap: var(--space-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .action {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    background: none;
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .action:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .action.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .action.primary:hover {
    color: var(--on-accent);
    opacity: 0.9;
  }
  .empty {
    padding: var(--space-5) 0;
  }
</style>

<script>
  import { fonts, displayWeight } from "../lib/fonts";
  import { loadFont } from "../lib/fontLoader";
  import { getPins, setPins } from "../lib/pins";
  import { renderImage, downloadCanvas } from "../lib/shareImage";

  const DEFAULT_TITLE = "陋室铭";
  const DEFAULT_BODY =
    "山不在高，有仙则名。水不在深，有龙则灵。斯是陋室，惟吾德馨。苔痕上阶绿，草色入帘青。谈笑有鸿儒，往来无白丁。";

  const byId = new Map(fonts.map((f) => [f.id, f]));
  const q = new URLSearchParams(location.search);
  const head = byId.get(q.get("h") ?? "");
  const body = byId.get(q.get("b") ?? "");
  const pickWeight = (f: (typeof fonts)[number], w: string | null) =>
    f.weights.includes(Number(w)) ? Number(w) : displayWeight(f.weights);
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;

  if (!head || !body) {
    $("[data-sheet]").hidden = true;
    document.querySelector<HTMLElement>(".fonts")!.hidden = true;
    document.querySelector<HTMLElement>(".actions")!.hidden = true;
    $("[data-empty]").hidden = false;
  } else {
    const hw = pickWeight(head, q.get("hw"));
    const bw = pickWeight(body, q.get("bw"));
    const title = (q.get("t") ?? "").slice(0, 60) || DEFAULT_TITLE;
    const text = (q.get("p") ?? "").slice(0, 600) || DEFAULT_BODY;
    document.title = `${head.name.zh} + ${body.name.zh} · 字体搭配 · 字相`;

    const headEl = $("[data-head]");
    const bodyEl = $("[data-body]");
    headEl.textContent = title;
    bodyEl.textContent = text;
    const links: [HTMLAnchorElement, typeof head][] = [
      [$("[data-head-link]"), head],
      [$("[data-body-link]"), body],
    ];
    for (const [a, f] of links) {
      a.href = `/fonts/${f.id}/`;
      a.textContent = `${f.name.zh} ${f.name.en !== f.name.zh ? f.name.en : ""}`.trim();
    }

    const families: { head?: string; body?: string } = {};
    const show = async (el: HTMLElement, f: typeof head, w: number, t: string, key: "head" | "body") => {
      el.style.fontWeight = String(w);
      try {
        const fam = await loadFont(f, w, t, { subset: true });
        families[key] = fam;
        el.style.fontFamily = `"${fam}", var(--font-ui)`;
      } catch {
        /* falls back to the interface font */
      }
      el.dataset.state = "ready";
    };
    const loaded = Promise.all([show(headEl, head, hw, title, "head"), show(bodyEl, body, bw, text, "body")]);

    const status = $("[data-status]");
    const flash = (msg: string) => {
      status.textContent = msg;
      setTimeout(() => (status.textContent = ""), 2500);
    };

    $("[data-copy]").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        flash("链接已复制");
      } catch {
        flash("复制失败，请手动复制地址栏");
      }
    });

    $("[data-save]").addEventListener("click", async () => {
      await loaded;
      await document.fonts.ready;
      const canvas = renderImage(
        [
          [
            { text: title, family: families.head ?? "", weight: hw, size: 88, lineHeight: 1.3 },
            { text, family: families.body ?? "", weight: bw, size: 34, lineHeight: 1.9 },
            {
              label: `标题：${head.name.zh}　正文：${body.name.zh}`,
              text: "",
              family: "",
              weight: 400,
              size: 1,
              lineHeight: 1,
            },
          ],
        ],
        { width: 1600 },
      );
      downloadCanvas(canvas, `字体搭配-${head.name.zh}-${body.name.zh}.png`);
    });

    $("[data-pin-both]").addEventListener("click", () => {
      const pins = getPins().filter((p) => p.id !== head.id && p.id !== body.id);
      setPins([{ id: head.id, weight: hw }, { id: body.id, weight: bw }, ...pins].slice(0, 4));
      flash("已钉选");
    });
  }
</script>
