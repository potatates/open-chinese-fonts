---
// 反馈: a short form whose messages go to the site's Worker (worker/index.js,
// POST /api/feedback) and are saved in Cloudflare; read them with `npm run feedback`.
// Works without JavaScript too (the Worker then redirects back here with ?sent=1).
import Base from "../layouts/Base.astro";
import { breadcrumbs } from "../lib/seo";

const KINDS = [
  { id: "问题", hint: "页面出错、字体显示不对、授权或分数有误" },
  { id: "建议", hint: "想要的功能、哪里不好用" },
  { id: "推荐字体", hint: "推荐一款免费商用的中文字体" },
  { id: "其他", hint: "" },
];
---

<Base
  title="反馈"
  description="给字相提意见：报告错误、提出建议、推荐免费商用中文字体。不需要注册，留言只有站长能看到。"
  jsonLd={breadcrumbs([
    ["全部字体", "/"],
    ["反馈", "/feedback/"],
  ])}
>
  <section class="intro">
    <h1>反馈</h1>
    <p class="lede">
      发现错误、有想要的功能，或者知道一款应该收录的免费字体？告诉我。不需要注册，留言只有我能看到。
    </p>
  </section>

  <p class="done" data-done hidden role="status">
    <strong>收到了，谢谢！</strong>
    <span>如果留了联系方式，我会尽快回复。</span>
    <a href="/feedback/" data-again>再写一条</a>
  </p>

  <form class="form" method="post" action="/api/feedback" data-form>
    <p class="about caption" data-about hidden></p>
    <input type="hidden" name="page" data-page />

    <fieldset class="kinds">
      <legend class="label">类型</legend>
      <div class="chips">
        {
          KINDS.map((k, i) => (
            <label class="chip" title={k.hint}>
              <input type="radio" name="kind" value={k.id} checked={i === 0} />
              <span>{k.id}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="field">
      <span class="label">内容</span>
      <textarea name="message" rows="6" maxlength="3000" required placeholder="写下你想说的…" data-message></textarea>
    </label>

    <label class="field">
      <span class="label">联系方式 <span class="caption">（选填：邮箱、微信或小红书，方便我回复你）</span></span>
      <input type="text" name="contact" maxlength="200" autocomplete="email" />
    </label>

    <!-- Robots fill in every field; people never see this one -->
    <label class="trap" aria-hidden="true">
      网站 <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>

    <div class="actions">
      <button type="submit" class="send" data-send>发送</button>
      <p class="status caption" data-status role="status"></p>
    </div>
  </form>
</Base>

<style>
  .intro {
    padding: var(--space-7) 0 var(--space-5);
    max-width: 42em;
  }
  h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }
  .lede {
    color: var(--ink-2);
    line-height: 1.8;
  }
  .form,
  .done {
    max-width: 36rem;
    padding-bottom: var(--space-8);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .about {
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--accent);
  }
  .label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .label .caption {
    font-weight: 400;
  }
  .kinds {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
    line-height: 1.5;
    transition:
      background-color var(--duration),
      border-color var(--duration),
      color var(--duration);
  }
  .chip:hover span {
    border-color: var(--ink);
  }
  .chip input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .field textarea,
  .field input {
    display: block;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    line-height: 1.7;
  }
  .field textarea {
    resize: vertical;
  }
  .field textarea:focus,
  .field input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .send {
    padding: var(--space-2) var(--space-6);
    border: 0;
    border-radius: 2px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-md);
    font-weight: 600;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .status[data-error] {
    color: var(--accent);
  }
  .done {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    line-height: 1.8;
  }
  .done[hidden],
  .form[hidden] {
    display: none;
  }
</style>

<script>
  import { fonts } from "../lib/fonts";

  const form = document.querySelector<HTMLFormElement>("[data-form]")!;
  const done = document.querySelector<HTMLElement>("[data-done]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const send = document.querySelector<HTMLButtonElement>("[data-send]")!;
  const q = new URLSearchParams(location.search);

  const ERRORS: Record<string, string> = {
    empty: "请先写点内容。",
    "too-many": "发送得太频繁了，请过一会儿再试。",
    "bad-request": "发送失败，请再试一次。",
  };

  // Opened from a font page (/feedback/?font=<id>): say which font it's about
  const font = fonts.find((f) => f.id === q.get("font"));
  if (font) {
    const about = document.querySelector<HTMLElement>("[data-about]")!;
    about.textContent = `关于字体：${font.name.zh}`;
    about.hidden = false;
    // as the default value, so it survives form.reset()
    document.querySelector<HTMLInputElement>("[data-page]")!.setAttribute("value", `/fonts/${font.id}/`);
  }

  function showDone() {
    form.hidden = true;
    done.hidden = false;
  }
  // Coming back from a form sent without JavaScript
  if (q.get("sent")) showDone();
  if (q.get("error")) {
    status.textContent = ERRORS[q.get("error")!] ?? ERRORS["bad-request"];
    status.dataset.error = "";
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    send.disabled = true;
    status.textContent = "发送中…";
    delete status.dataset.error;
    try {
      const res = await fetch("/api/feedback", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const body = (await res.json()) as { ok: boolean; error?: string };
      if (!body.ok) throw new Error(body.error);
      form.reset();
      status.textContent = "";
      showDone();
    } catch (err) {
      status.textContent = ERRORS[(err as Error).message] ?? "发送失败，请检查网络后再试。";
      status.dataset.error = "";
    } finally {
      send.disabled = false;
    }
  });

  document.querySelector("[data-again]")!.addEventListener("click", (e) => {
    e.preventDefault();
    done.hidden = true;
    form.hidden = false;
    history.replaceState(null, "", "/feedback/");
    document.querySelector<HTMLTextAreaElement>("[data-message]")!.focus();
  });
</script>
