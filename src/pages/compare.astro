---
// Side-by-side comparison of your pinned fonts (up to 4).
// Everything here is drawn in the browser, because the pinned list lives
// in the browser (localStorage). A shared link (?fonts=…) replaces the pins.
import Base from "../layouts/Base.astro";
import samples from "../data/samples.json";
---

<Base title="对比" bar="none" description="免费在线并排对比 2–4 款中文字体：同一段文字、同样的字号与行距，看清字形、字重和气质的差别，还能保存为图片分享。">
  <section class="intro">
    <h1>对比</h1>
    <p class="caption">最多 4 款字体并排比较。这里显示的就是你钉选的字体。</p>
  </section>

  <!-- Computers: text box, fonts and 添加字体 on the left; type settings in a
       sticky column on the right, so all fonts fit on screen.
       Phones: settings first, then the rest. -->
  <div class="compare-layout">
    <aside class="panel" aria-label="对比设置">
      <div class="controls">
        <div class="control">
          <label for="c-size" class="caption">字号</label>
          <input id="c-size" type="range" min="16" max="160" step="1" value="48" />
          <output for="c-size" class="caption" data-out="size"></output>
        </div>
        <div class="control">
          <label for="c-lh" class="caption">行高</label>
          <input id="c-lh" type="range" min="1" max="2.4" step="0.05" value="1.5" />
          <output for="c-lh" class="caption" data-out="lh"></output>
        </div>
        <div class="control">
          <label for="c-ls" class="caption">字距</label>
          <input id="c-ls" type="range" min="-0.1" max="0.5" step="0.01" value="0" />
          <output for="c-ls" class="caption" data-out="ls"></output>
        </div>
        <div class="colors">
          <label class="caption swatch">文字 <input id="c-fg" type="color" /></label>
          <label class="caption swatch">背景 <input id="c-bg" type="color" /></label>
          <button type="button" class="text-button" data-invert>反转</button>
          <button type="button" class="text-button reset" data-reset>重置全部</button>
        </div>
        <p class="caption contrast" data-contrast aria-live="polite"></p>
      </div>

    </aside>

    <div class="main">
      <div class="text-field">
        <div class="field-head">
          <label for="cmp-text" class="caption">对比文字</label>
          <span class="field-actions">
            <button type="button" class="text-button" data-shuffle>换一句</button>
            <button type="button" class="text-button" data-save-image>保存为图片</button>
          </span>
        </div>
        <textarea id="cmp-text" rows="1" lang="zh-Hans">{samples[0].text}</textarea>
      </div>

      <div class="stage" data-stage>
        <div class="columns" data-columns></div>
        <p class="empty" data-empty hidden>
          还没有要对比的字体。从下方「添加字体」中选择，或在<a href="/">字体列表</a>中点按「钉选」。
        </p>
      </div>

      <section class="add" aria-labelledby="add-title">
        <h2 id="add-title" class="section-title">添加字体 <span class="caption" data-add-count></span></h2>
        <!-- First a few suggestions; every other font is behind search or 显示全部 -->
        <p class="add-sub caption" data-suggest-title></p>
        <div class="add-list" data-suggest-list></div>
        <div class="add-tools">
          <label class="visually-hidden" for="add-search">搜索字体</label>
          <input id="add-search" type="search" class="add-search" placeholder="搜索全部字体：名称、拼音、设计师" data-add-search />
          <button type="button" class="add-all-toggle" data-add-all aria-expanded="false" aria-controls="add-all"></button>
        </div>
        <div id="add-all" class="add-all" data-add-all-list hidden></div>
      </section>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6) 0 var(--space-5);
  }
  h1 {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 1024px) {
    .compare-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      column-gap: var(--space-7);
      align-items: start;
    }
    /* The panel comes first in the HTML (keyboard users meet the settings
       first) but sits in the right column, and stays put while you scroll. */
    .panel {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--space-5);
      max-height: calc(100vh - 2 * var(--space-5));
      overflow-y: auto;
    }
    .main {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .text-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 40rem;
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--rule); /* lines up with the panel's top line */
  }
  .field-actions {
    display: flex;
    gap: var(--space-4);
  }
  .field-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  #cmp-text {
    width: 100%;
    padding: var(--space-1) 0;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    background: transparent;
    font-size: var(--text-md);
    line-height: 1.6;
    resize: none;
    overflow: hidden; /* grows with its text instead (see autosize) */
  }
  #cmp-text:focus-visible {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* label | slider | value, lined up in three columns */
  .control {
    display: grid;
    grid-template-columns: 2.5em 1fr 5ch;
    align-items: center;
    gap: var(--space-2);
  }
  .control input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }
  .control output {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .colors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-2);
  }
  .reset {
    margin-left: auto;
  }
  .swatch {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .swatch input {
    width: 28px;
    height: 22px;
    padding: 0;
    border: 1px solid var(--rule-strong);
    background: none;
    cursor: pointer;
  }
  .contrast:empty {
    display: none;
  }
  .text-button {
    background: none;
    border: 0;
    padding: var(--space-1) 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .text-button:hover {
    color: var(--accent);
  }

  /* The stage carries the chosen colors; columns sit on it */
  .stage {
    --fg: var(--ink);
    --bg: var(--paper);
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid var(--rule);
  }
  .stage[data-custom] {
    padding: 0 var(--space-5);
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .columns {
      /* Columns never get wider than --col-max, so lines stay short enough to
         read without big eye movements. 4 fonts wrap into 2 × 2 (set in the
         script), because 4 in a row would be too narrow to read. */
      --col-max: 480px;
      grid-template-columns: repeat(var(--cols, 1), minmax(0, var(--col-max)));
      column-gap: var(--space-7);
      row-gap: var(--space-4);
    }
  }
  /* Hold room for the columns until the script draws them, so 添加字体 below
     doesn't jump down on load (about the height of 2 columns of the sample) */
  :global(html.js) .stage:not([data-ready]) .columns {
    min-height: 19.5rem;
  }
  .empty {
    padding: var(--space-7) 0;
    color: var(--ink-2);
  }

  .section-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .add {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }
  .add-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .add-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-2);
  }
  .add-search {
    flex: 1 1 16rem;
    max-width: 24rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
  }
  .add-search:focus {
    outline: none;
    border-color: var(--accent);
  }
  .add-all-toggle {
    background: none;
    border: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .add-all-toggle:hover {
    color: var(--accent);
  }
  .add-all {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .add-all[hidden] {
    display: none;
  }
  :global(.add-group-title) {
    margin-bottom: var(--space-2);
  }

  /* Columns are created by the script below, so their styles must be global */
  :global(.col) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-6);
    min-width: 0;
  }
  @media (max-width: 767px) {
    :global(.col + .col) {
      border-top: 1px solid var(--rule);
    }
  }
  :global(.col-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    font-size: var(--text-sm);
  }
  :global(.col-head a) {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  :global(.col-head a:hover) {
    color: var(--accent);
  }
  :global(.col-weight) {
    font-size: var(--text-xs);
    opacity: 0.7;
  }
  :global(.col-head select) {
    font: inherit;
    font-size: var(--text-xs);
  }
  /* 16px on touch screens: smaller makes iOS zoom the page when tapped */
  @media (pointer: coarse) {
    :global(.col-head select) {
      font-size: 16px;
    }
  }
  :global(.col-head select) {
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent);
    border-radius: 2px;
    padding: 1px var(--space-1);
  }
  :global(.col-head .pin-remove) {
    color: inherit;
    opacity: 0.6;
  }
  :global(.col-sample) {
    font-size: var(--size, 48px);
    line-height: var(--lh, 1.5);
    letter-spacing: var(--ls, 0);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    transition: opacity var(--duration);
  }
  :global(html.js .col-sample[data-state="idle"]) {
    opacity: 0;
  }
  :global(.add-button) {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  :global(.add-button) {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  :global(.add-plus) {
    color: var(--ink-2);
  }
  :global(.add-name) {
    font-size: var(--text-lg);
    line-height: 1.3;
    transition: opacity var(--duration);
  }
  :global(html.js .add-name[data-state="idle"]) {
    opacity: 0;
  }
  :global(.add-button:hover) {
    border-color: var(--ink);
    color: var(--accent);
  }
  :global(.add-button:disabled) {
    cursor: not-allowed;
    color: var(--ink-2);
    border-style: dashed;
  }
</style>

<script>
  import { fonts, categoryLabel, displayWeight, WEIGHT_NAMES, CATEGORIES, searchText, normalizeQuery } from "../lib/fonts";
  import { nearest } from "../lib/nudge";
  import { FEATURED } from "../lib/homeOrder";
  import { getPins, isFull, MAX_PINS, onPinsChange, setPins, setPinWeight, togglePin } from "../lib/pins";
  import { renderImage, downloadCanvas } from "../lib/shareImage";
  import { loadFont } from "../lib/fontLoader";
  import samples from "../data/samples.json";

  const byId = new Map(fonts.map((f) => [f.id, f]));
  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const text = $<HTMLTextAreaElement>("#cmp-text");
  const size = $<HTMLInputElement>("#c-size");
  const lh = $<HTMLInputElement>("#c-lh");
  const ls = $<HTMLInputElement>("#c-ls");
  const fg = $<HTMLInputElement>("#c-fg");
  const bg = $<HTMLInputElement>("#c-bg");
  const stage = $<HTMLElement>("[data-stage]");
  const columns = $<HTMLElement>("[data-columns]");
  const emptyEl = $<HTMLElement>("[data-empty]");
  const addSection = $<HTMLElement>("section.add");
  const suggestTitle = $<HTMLElement>("[data-suggest-title]");
  const suggestList = $<HTMLElement>("[data-suggest-list]");
  const addSearch = $<HTMLInputElement>("[data-add-search]");
  const addAllToggle = $<HTMLButtonElement>("[data-add-all]");
  const addAllList = $<HTMLElement>("[data-add-all-list]");
  let showAll = false;
  const contrastEl = $<HTMLElement>("[data-contrast]");

  // ---- Load state from the URL (a shared comparison link)
  const params = new URLSearchParams(location.search);
  const urlFonts = params.get("fonts");
  if (urlFonts) {
    setPins(
      urlFonts.split(",").map((part) => {
        const [id, w] = part.split(":");
        const font = byId.get(id);
        const weight = Number(w);
        return { id, weight: font?.weights.includes(weight) ? weight : (font?.weights[0] ?? 400) };
      }),
    );
  }
  if (params.get("t")) text.value = params.get("t")!;
  if (params.get("size")) size.value = params.get("size")!;
  if (params.get("lh")) lh.value = params.get("lh")!;
  if (params.get("ls")) ls.value = params.get("ls")!;
  let customColors = params.has("fg") && params.has("bg");

  function syncUrl() {
    const p = new URLSearchParams();
    const pins = getPins();
    if (pins.length) p.set("fonts", pins.map((x) => `${x.id}:${x.weight}`).join(","));
    if (text.value.trim() && text.value !== samples[0].text) p.set("t", text.value);
    if (size.value !== size.defaultValue) p.set("size", size.value);
    if (lh.value !== lh.defaultValue) p.set("lh", lh.value);
    if (ls.value !== ls.defaultValue) p.set("ls", ls.value);
    if (customColors) {
      p.set("fg", fg.value);
      p.set("bg", bg.value);
    }
    history.replaceState(null, "", `?${p.toString().replace(/%2C/g, ",").replace(/%3A/g, ":")}`);
  }

  // ---- Colors
  // Turn a computed "rgb(r, g, b)" into "#rrggbb" for the color inputs.
  function toHex(rgb: string) {
    const [r, g, b] = rgb.match(/\d+/g)!.map(Number);
    return "#" + [r, g, b].map((n) => n.toString(16).padStart(2, "0")).join("");
  }
  // WCAG contrast ratio between two hex colors (4.5:1 is the usual minimum for text)
  function contrast(a: string, b: string) {
    const lum = (hex: string) => {
      const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
      const [r, g, bl] = c.map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
      return 0.2126 * r + 0.7152 * g + 0.0722 * bl;
    };
    const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
    return (hi + 0.05) / (lo + 0.05);
  }
  function applyColors() {
    if (customColors) {
      stage.style.setProperty("--fg", fg.value);
      stage.style.setProperty("--bg", bg.value);
      stage.dataset.custom = "";
      const ratio = contrast(fg.value, bg.value);
      contrastEl.textContent = `对比度 ${ratio.toFixed(1)}:1${ratio < 4.5 ? "，偏低，正文可能不易阅读" : ""}`;
    } else {
      // Follow the site's light/dark theme until you pick your own colors
      stage.style.removeProperty("--fg");
      stage.style.removeProperty("--bg");
      delete stage.dataset.custom;
      const cs = getComputedStyle(document.body);
      fg.value = toHex(cs.color);
      bg.value = toHex(cs.backgroundColor);
      contrastEl.textContent = "";
    }
  }
  if (customColors) {
    fg.value = params.get("fg")!;
    bg.value = params.get("bg")!;
  }

  // ---- Type settings, applied to all columns through CSS variables
  function applySettings() {
    stage.style.setProperty("--size", `${size.value}px`);
    stage.style.setProperty("--lh", lh.value);
    stage.style.setProperty("--ls", `${ls.value}em`);
    $("[data-out=size]").textContent = `${size.value}px`;
    $("[data-out=lh]").textContent = Number(lh.value).toFixed(2);
    $("[data-out=ls]").textContent = `${Number(ls.value).toFixed(2)}em`;
  }

  // ---- Columns
  const loaded = new Map<string, string>(); // "id|weight" → font-family, to avoid flicker on re-draw

  async function fontInto(node: HTMLElement, id: string, weight: number) {
    const key = `${id}|${weight}`;
    node.style.fontWeight = String(weight);
    node.dataset.key = key;
    const known = loaded.get(key);
    if (known) {
      node.style.fontFamily = `"${known}", var(--font-ui)`;
      node.dataset.state = "ready";
    }
    try {
      // Also run for already-loaded fonts: it fetches pieces for any new characters.
      const family = await loadFont(byId.get(id)!, weight, text.value || byId.get(id)!.name.zh);
      loaded.set(key, family);
      if (node.dataset.key !== key) return;
      node.style.fontFamily = `"${family}", var(--font-ui)`;
      node.dataset.state = "ready";
    } catch (err) {
      console.warn(err);
      node.dataset.state = "error";
    }
  }

  // "保存为图片": the same fonts, text, size, spacing and colors, as a PNG
  $("[data-save-image]").addEventListener("click", async () => {
    const pins = getPins();
    if (!pins.length) return;
    const t = text.value.trim() || "春眠不觉晓，处处闻啼鸟。";
    const families = await Promise.all(
      pins.map((p) => loaded.get(`${p.id}|${p.weight}`) ?? loadFont(byId.get(p.id)!, p.weight, t)),
    );
    await document.fonts.ready;
    const canvas = renderImage(
      pins.map((p, i) => {
        const f = byId.get(p.id)!;
        return [
          {
            label: `${f.name.zh}　${WEIGHT_NAMES[p.weight]}`,
            text: t,
            family: families[i],
            weight: p.weight,
            size: Number(size.value),
            lineHeight: Number(lh.value),
            letterSpacing: Number(ls.value),
          },
        ];
      }),
      { perRow: pins.length === 4 ? 2 : pins.length, background: bg.value, ink: fg.value },
    );
    downloadCanvas(canvas, `字体对比-${pins.map((p) => byId.get(p.id)!.name.zh).join("-")}.png`);
  });

  function renderColumns() {
    const pins = getPins();
    columns.style.setProperty("--cols", String(pins.length === 4 ? 2 : Math.max(pins.length, 1)));
    emptyEl.hidden = pins.length > 0;
    stage.dataset.ready = "";
    columns.replaceChildren(
      ...pins.map((pin) => {
        const font = byId.get(pin.id)!;
        const col = document.createElement("article");
        col.className = "col";
        col.setAttribute("aria-label", font.name.zh);

        const head = document.createElement("header");
        head.className = "col-head";
        const link = document.createElement("a");
        link.href = `/fonts/${font.id}/`;
        link.textContent = font.name.zh;
        const cat = document.createElement("span");
        cat.className = "caption";
        cat.style.color = "inherit";
        cat.textContent = categoryLabel(font);
        // Only fonts with more than one weight get a menu; otherwise just say which weight it is
        let weightEl: HTMLElement;
        if (font.weights.length > 1) {
          const select = document.createElement("select");
          select.dataset.colWeight = font.id;
          select.setAttribute("aria-label", `${font.name.zh}的字重`);
          for (const w of font.weights) {
            select.append(new Option(`${WEIGHT_NAMES[w]} ${w}`, String(w), false, w === pin.weight));
          }
          weightEl = select;
        } else {
          weightEl = document.createElement("span");
          weightEl.className = "col-weight";
          weightEl.textContent = `${WEIGHT_NAMES[pin.weight]} ${pin.weight}`;
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "pin-remove";
        remove.dataset.unpin = font.id; // handled by the pin tray code, which unpins it
        remove.setAttribute("aria-label", `移除 ${font.name.zh}`);
        remove.textContent = "×";
        head.append(link, cat, weightEl, remove);

        const sample = document.createElement("p");
        sample.className = "col-sample";
        sample.lang = "zh-Hans";
        sample.dataset.state = "idle";
        sample.textContent = text.value;
        fontInto(sample, pin.id, pin.weight);

        col.append(head, sample);
        return col;
      }),
    );
  }

  // Draw a font's name in that font (tiny name-only subsets; ~2 KB each).
  // Remembered, so re-drawing the list doesn't flicker.
  const nameFamilies = new Map<string, string>();
  // With hundreds of fonts, only load a name's font once it scrolls near view
  const nameObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        nameObserver.unobserve(el);
        loadNameFont(el, el.dataset.nameFor!);
      }
    },
    { rootMargin: "300px 0px" },
  );
  function nameInFont(el: HTMLElement, id: string) {
    if (nameFamilies.has(id)) return loadNameFont(el, id);
    el.dataset.nameFor = id;
    el.dataset.state = "idle";
    nameObserver.observe(el);
  }
  function loadNameFont(el: HTMLElement, id: string) {
    const font = byId.get(id)!;
    const weight = displayWeight(font.weights);
    el.style.fontWeight = String(weight);
    const known = nameFamilies.get(id);
    if (known) {
      el.style.fontFamily = `"${known}", var(--font-ui)`;
      return;
    }
    el.dataset.state = "idle";
    loadFont(font, weight, font.name.zh, { subset: true })
      .then((family) => {
        nameFamilies.set(id, family);
        el.style.fontFamily = `"${family}", var(--font-ui)`;
        el.dataset.state = "ready";
      })
      .catch(() => (el.dataset.state = "ready")); // fall back to the interface font
  }

  function addButton(id: string): HTMLButtonElement {
    const f = byId.get(id)!;
    const b = document.createElement("button");
    b.type = "button";
    b.className = "add-button";
    b.dataset.add = f.id;
    // "+" in the interface font, the name in the font itself
    const plus = document.createElement("span");
    plus.className = "add-plus";
    plus.textContent = "+";
    const name = document.createElement("span");
    name.className = "add-name";
    name.lang = "zh-Hans";
    name.textContent = f.name.zh;
    nameInFont(name, f.id);
    b.append(plus, name);
    b.setAttribute("aria-label", `添加 ${f.name.zh}`);
    b.disabled = isFull();
    if (b.disabled) b.title = `最多 ${MAX_PINS} 款，请先移除一款`;
    return b;
  }

  function renderAddList() {
    const pinned = getPins().map((p) => p.id);
    $("[data-add-count]").textContent = `已选 ${pinned.length}/${MAX_PINS}`;
    // Suggestions: fonts like the ones being compared, or popular ones to start with
    const suggest = pinned.length ? nearest(pinned, 12) : FEATURED.filter((id) => byId.has(id)).slice(0, 12);
    suggestTitle.textContent = pinned.length ? "相似字体" : "常用字体";
    suggestList.replaceChildren(...suggest.map(addButton));

    // Everything else: only when searching or 显示全部 is open
    const q = normalizeQuery(addSearch.value);
    const rest = fonts.filter((f) => !pinned.includes(f.id) && (!q || searchText(f).includes(q)));
    const open = showAll || q !== "";
    addAllList.hidden = !open;
    addAllToggle.hidden = q !== "";
    addAllToggle.textContent = showAll ? "收起全部字体" : `显示全部 ${fonts.length} 款`;
    addAllToggle.setAttribute("aria-expanded", String(showAll));
    if (!open) {
      addAllList.replaceChildren();
      return;
    }
    if (q) {
      const hits = rest.map((f) => addButton(f.id));
      const box = document.createElement("div");
      box.className = "add-list";
      box.append(...hits);
      const note = document.createElement("p");
      note.className = "caption add-group-title";
      note.textContent = hits.length ? `找到 ${hits.length} 款` : "没有找到，换个关键词试试";
      addAllList.replaceChildren(note, box);
      return;
    }
    // Grouped by category, so the full list is easier to scan. The categories
    // of the fonts being compared come first (most picked first; on a tie,
    // the bigger category first).
    const picked = (id: string) => pinned.filter((p) => byId.get(p)!.category === id).length;
    const size = (id: string) => fonts.filter((f) => f.category === id).length;
    const order = CATEGORIES.map((c, i) => ({ c, i }));
    if (pinned.length)
      order.sort((a, b) => picked(b.c.id) - picked(a.c.id) || size(b.c.id) - size(a.c.id) || a.i - b.i);
    addAllList.replaceChildren(
      ...order.map(({ c }) => {
        const inCat = rest.filter((f) => f.category === c.id);
        const group = document.createElement("div");
        const title = document.createElement("p");
        title.className = "caption add-group-title";
        title.textContent = `${c.zh} · ${inCat.length} 款`;
        const box = document.createElement("div");
        box.className = "add-list";
        box.append(...inCat.map((f) => addButton(f.id)));
        group.append(title, box);
        return group;
      }).filter((g) => g.querySelector("button")),
    );
  }

  function renderAll() {
    renderColumns();
    renderAddList();
    syncUrl();
  }

  // ---- Events
  addSection.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-add]");
    if (!b) return;
    const font = byId.get(b.dataset.add!)!;
    togglePin(font.id, font.weights.includes(400) ? 400 : font.weights[0]);
    // keep keyboard focus in the suggestions after they re-draw
    suggestList.querySelector<HTMLButtonElement>("button:not(:disabled)")?.focus();
  });
  addSearch.addEventListener("input", (e) => {
    if ((e as InputEvent).isComposing) return; // wait for finished pinyin input
    renderAddList();
  });
  addSearch.addEventListener("compositionend", renderAddList);
  addAllToggle.addEventListener("click", () => {
    showAll = !showAll;
    renderAddList();
  });
  columns.addEventListener("change", (e) => {
    const s = (e.target as Element).closest<HTMLSelectElement>("[data-col-weight]");
    if (!s) return;
    setPinWeight(s.dataset.colWeight!, Number(s.value));
    columns.querySelector<HTMLSelectElement>(`[data-col-weight="${s.dataset.colWeight}"]`)?.focus();
  });

  // The text box grows with its content, so its underline sits right below the text
  function autosize() {
    text.style.height = "auto";
    text.style.height = `${text.scrollHeight}px`;
  }
  window.addEventListener("resize", autosize);

  let typing: ReturnType<typeof setTimeout>;
  text.addEventListener("input", (e) => {
    autosize();
    if ((e as InputEvent).isComposing) return;
    // Text changes instantly in every column; fonts fetch new characters as needed
    columns.querySelectorAll<HTMLElement>(".col-sample").forEach((s) => (s.textContent = text.value));
    clearTimeout(typing);
    typing = setTimeout(() => {
      getPins().forEach((pin, i) => {
        const s = columns.querySelectorAll<HTMLElement>(".col-sample")[i];
        if (s) fontInto(s, pin.id, pin.weight);
      });
      syncUrl();
    }, 300);
  });
  text.addEventListener("compositionend", () => text.dispatchEvent(new Event("input")));

  $("[data-shuffle]").addEventListener("click", () => {
    const others = samples.filter((s) => s.text !== text.value);
    text.value = others[Math.floor(Math.random() * others.length)].text;
    text.dispatchEvent(new Event("input"));
  });

  for (const input of [size, lh, ls]) {
    input.addEventListener("input", () => {
      applySettings();
      syncUrl();
    });
  }
  for (const input of [fg, bg]) {
    input.addEventListener("input", () => {
      customColors = true;
      applyColors();
      syncUrl();
    });
  }
  $("[data-invert]").addEventListener("click", () => {
    [fg.value, bg.value] = [bg.value, fg.value];
    customColors = true;
    applyColors();
    syncUrl();
  });
  $("[data-reset]").addEventListener("click", () => {
    for (const input of [size, lh, ls]) input.value = input.defaultValue;
    customColors = false;
    applySettings();
    applyColors();
    syncUrl();
  });

  // The 配色 switch changes the default colors, so refresh the color pickers
  window.addEventListener("themechange", () => {
    if (!customColors) applyColors();
  });

  // ---- Start
  autosize();
  applySettings();
  applyColors();
  onPinsChange(renderAll);
  renderAll();
</script>
