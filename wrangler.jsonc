// Cloudflare deployment settings. The site is fully static: `npm run build`
// writes it to dist/, and Cloudflare serves those files as they are.
{
  "name": "open-chinese-fonts",
  "compatibility_date": "2026-09-01",
  // worker/index.js answers only the addresses in run_worker_first
  // (search-engine verification files, the feedback form); everything else is static
  "main": "worker/index.js",
  // Messages sent with the 反馈 form (read them with: npm run feedback)
  "kv_namespaces": [{ "binding": "FEEDBACK", "id": "2ec5f3b3e8ff4f068f2803d41ced7008" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown addresses show our 404 page (src/pages/404.astro)
    "not_found_handling": "404-page",
    "run_worker_first": ["/google38ae56ad0c5892c8.html", "/api/*"]
  }
}
