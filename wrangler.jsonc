// Cloudflare deployment settings. The site is fully static: `npm run build`
// writes it to dist/, and Cloudflare serves those files as they are.
{
  "name": "open-chinese-fonts",
  "compatibility_date": "2026-09-01",
  // worker/index.js answers only the addresses in run_worker_first
  // (search-engine verification files); everything else is static
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown addresses show our 404 page (src/pages/404.astro)
    "not_found_handling": "404-page",
    "run_worker_first": ["/google38ae56ad0c5892c8.html"]
  }
}
